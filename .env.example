# SIP — environment variables
#
# Copy to .env for local development. In production these live in Railway
# (Service -> Variables), NOT in a file. Never commit real values.

# --- Azure AI Foundry -------------------------------------------------------
AZURE_AI_PROJECT_ENDPOINT=https://<your-foundry-resource>.services.ai.azure.com/api/projects/<project>
AZURE_AI_API_KEY=
MODEL_DEPLOYMENT=gpt-5-mini

# --- Azure service principal ------------------------------------------------
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# --- Application ------------------------------------------------------------
# On Railway this points at the mounted volume: /data/sip.db
SIP_DB_PATH=./sip.db

# Primary demo account
SIP_AUTH_EMAIL=
SIP_AUTH_PASSWORD=

# Additional demo accounts, JSON object: {"email@example.com": "password"}
SIP_AUTH_EXTRA_USERS={}

# Random 64-char string, e.g. python -c "import secrets; print(secrets.token_hex(32))"
SIP_SESSION_SECRET=

# true in production (HTTPS only), false for local http://localhost
SIP_COOKIE_SECURE=false

# Role for the primary account (admin | product_owner | sales), default admin
SIP_AUTH_ROLE=admin

# Injected by Railway in production; falls back to 8000
# PORT=8000

# Embedding deployment for semantic search. Note it answers on the RESOURCE ROOT,
# not the /api/projects/... path the chat model uses; the code derives that.
EMBEDDING_DEPLOYMENT=text-embedding-3-large
# Optional override if the embedding deployment lives on a different resource.
# AZURE_AI_EMBEDDING_ENDPOINT=

# Retrieval engine: "lexical" (default, original behaviour) or "hybrid".
# Hybrid needs a vector index built with build_vector_index(); it falls back to
# lexical with a warning if the index file is missing.
SIP_RETRIEVAL=lexical
# Where the vector index lives. On Railway put it on the volume: /data/vectors.bin
# SIP_VECTOR_PATH=

# Minimum reciprocal-rank-fusion score required before a result may ground an
# answer. Lower values retrieve more; higher values prefer an honest no-match.
SIP_RELEVANCE_THRESHOLD=0.017

# Private uploads and extracted text. Defaults beside SIP_DB_PATH; use the
# persistent volume explicitly in production if desired.
# SIP_UPLOAD_ROOT=/data/uploads
